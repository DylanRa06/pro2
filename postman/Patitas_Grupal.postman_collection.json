    {
      "name": "1 - G1 registro y permisos USER",
      "item": [
        {
          "name": "01 Registrar USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/registrar",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameUser}}\",\n  \"password\": \"{{passwordDemo}}\",\n  \"rol\": \"ADMIN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Rol fijo USER\", () => pm.expect(pm.response.json().rol).to.eql(\"USER\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
