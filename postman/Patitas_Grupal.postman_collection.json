      "value": "http://localhost:8080"
    },
    {
      "key": "usernameUser",
      "value": "adoptante_grupal"
    },
    {
      "key": "usernameAdmin",
      "value": "admin_grupal"
    },
    {
      "key": "passwordDemo",
      "value": "ClaveDemo2026!"
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
